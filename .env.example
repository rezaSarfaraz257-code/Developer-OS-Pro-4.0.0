DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_DB=developeros
POSTGRES_USER=developeros
POSTGRES_PASSWORD=replace-with-a-strong-password
ALLOWED_HOSTS=your-domain.com
CORS_ALLOWED_ORIGINS=https://your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com
FRONTEND_URL=https://your-domain.com
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_SCOPE=read:user user:email repo
GITHUB_TOKEN_ENCRYPTION_KEY=
GITHUB_OAUTH_REDIRECT=https://your-domain.com/api/github/callback/
VITE_API_URL=/api
# Frontend Nginx upstream. Keep this without a trailing slash.
BACKEND_URL=http://backend:8000

# AI provider
# Set OPENAI_API_KEY on the backend service. AI_API_KEY is a backward-compatible alias.
OPENAI_API_KEY=
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1
AI_API_PROTOCOL=responses
AI_MODEL=gpt-5.6-luna

# Production HTTPS enforcement (keep true when your edge forwards X-Forwarded-Proto correctly)
SECURE_SSL_REDIRECT=true

RELEASE_VERSION=4.0.0

# Secure Web IDE runner (generate a long random value)
IDE_RUNNER_TOKEN=replace-with-32-plus-random-characters
IDE_RUNNER_URL=http://developer-os-runner:8080

# Production billing (Stripe)
# Product pricing: Pro $29/user/mo · Team $15/user/mo (seat quantity) · Enterprise from $299/mo.
# Create matching recurring Stripe Prices and place their price IDs below.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_ENTERPRISE=

# Mature SaaS
EMAIL_VERIFICATION_REQUIRED=true
DEFAULT_FROM_EMAIL=Developer OS <no-reply@example.com>
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
CACHE_URL=redis://redis:6379/1
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SERVER_SIDE_ENCRYPTION=AES256
EXPORT_ROOT=/app/media/exports

# Billing: only enable for local development/tests; never in production.
ALLOW_LOCAL_BILLING=false

# Runner security: strict mode requires a real isolation backend (e.g. bubblewrap).
RUNNER_SECURITY_LEVEL=strict
RUNNER_SANDBOX_MODE=bwrap
RUNNER_ALLOW_NETWORK=false
