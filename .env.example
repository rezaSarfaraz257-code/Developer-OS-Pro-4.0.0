DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_DB=developeros
POSTGRES_USER=developeros
POSTGRES_PASSWORD=replace-with-a-strong-password
ALLOWED_HOSTS=your-domain.com
CORS_ALLOWED_ORIGINS=https://your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com
FRONTEND_URL=https://your-domain.com
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_SCOPE=read:user user:email repo
GITHUB_TOKEN_ENCRYPTION_KEY=
GITHUB_OAUTH_REDIRECT=https://your-domain.com/api/github/callback/
VITE_API_URL=/api

# Optional AI provider (OpenAI-compatible /chat/completions endpoint)
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# Production HTTPS enforcement (keep true when your edge forwards X-Forwarded-Proto correctly)
SECURE_SSL_REDIRECT=true

RELEASE_VERSION=3.0.0-global

# Secure Web IDE runner (generate a long random value)
IDE_RUNNER_TOKEN=replace-with-32-plus-random-characters
IDE_RUNNER_URL=http://runner:8080

# Production billing (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_ENTERPRISE=

# Mature SaaS
EMAIL_VERIFICATION_REQUIRED=true
DEFAULT_FROM_EMAIL=Developer OS <no-reply@example.com>
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
CACHE_URL=redis://redis:6379/1
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SERVER_SIDE_ENCRYPTION=AES256
EXPORT_ROOT=/app/media/exports
