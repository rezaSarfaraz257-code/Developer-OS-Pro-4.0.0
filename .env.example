DEBUG=False
ENVIRONMENT=production
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_DB=developeros
POSTGRES_USER=developeros
POSTGRES_PASSWORD=replace-with-a-strong-password
ALLOWED_HOSTS=your-domain.com
CORS_ALLOWED_ORIGINS=https://your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com
FRONTEND_URL=https://your-domain.com
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_SCOPE=read:user user:email repo
GITHUB_TOKEN_ENCRYPTION_KEY=
GITHUB_OAUTH_REDIRECT=https://your-domain.com/api/github/callback/
VITE_API_URL=/api
BACKEND_URL=http://backend:8000

# AI provider
OPENAI_API_KEY=
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1
AI_API_PROTOCOL=responses
AI_MODEL=gpt-5.6-luna

# Production HTTPS enforcement
SECURE_SSL_REDIRECT=true
TRUST_PROXY_HEADERS=false

# PostgreSQL/ASGI runtime: bounded psycopg pool per web process.
# max_size is intentionally capped at 32 per process to prevent connection storms.
# Multiply max_size by web/worker replicas when sizing the PostgreSQL connection budget.
DB_POOL_ENABLED=true
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=4
DB_POOL_TIMEOUT=10

# Release identity: set RELEASE_SHA to the immutable deployed commit SHA.
RELEASE_VERSION=4.0.0
RELEASE_SHA=local

# Secure Web IDE runner
IDE_RUNNER_TOKEN=replace-with-32-plus-random-characters
IDE_RUNNER_URL=http://developer-os-runner:8080

# Production billing (Stripe)
# Pro: $29/month or $290/year. Team: $15/seat/month or $150/seat/year.
# REQUIRE_STRIPE_BILLING=true makes production_preflight fail until all advertised Stripe prices are configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_TEAM_ANNUAL=
STRIPE_PRICE_ENTERPRISE=
REQUIRE_STRIPE_BILLING=true

# Mature SaaS
EMAIL_VERIFICATION_REQUIRED=true
DEFAULT_FROM_EMAIL=Developer OS <no-reply@example.com>
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
CACHE_URL=redis://redis:6379/1
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SERVER_SIDE_ENCRYPTION=AES256
S3_PUBLIC_BASE_URL=
EXPORT_ROOT=/app/media/exports

ALLOW_LOCAL_BILLING=false

# Runner security
RUNNER_SECURITY_LEVEL=strict
RUNNER_SANDBOX_MODE=container
RUNNER_ALLOW_NETWORK=false
