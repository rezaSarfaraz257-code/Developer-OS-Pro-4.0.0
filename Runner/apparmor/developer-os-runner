# Dedicated AppArmor policy for the Developer OS Runner.
# The trusted Runner/bwrap control process may create its own unprivileged
# namespaces. The executed shell transitions into a workload profile that
# has no userns, mount, or capability permission.
abi <abi/4.0>,
#include <tunables/global>

profile developer-os-runner flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  # Bubblewrap needs NETLINK_ROUTE while preparing its isolated network namespace.
  # Keep raw IP and packet sockets denied; workload profile denies all raw sockets.
  network netlink raw,
  deny network inet raw,
  deny network inet6 raw,
  deny network packet,
  deny network alg,

  capability sys_admin,
  capability net_admin,
  capability setuid,
  capability setgid,
  capability sys_chroot,
  file,
  mount,
  umount,
  pivot_root,
  userns,

  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (send,receive) peer=developer-os-runner,
  signal (send,receive) peer=developer-os-runner-workload,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/kernel/security/** rwklx,

  # Bubblewrap launches this shell only after namespaces and mounts are set up.
  # The child profile removes the permissions needed to create another sandbox.
  /usr/bin/bash Px -> developer-os-runner-workload,
  /bin/bash Px -> developer-os-runner-workload,
}

profile developer-os-runner-workload flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  deny network raw,
  deny network packet,
  deny network alg,

  file,

  signal (receive) peer=developer-os-runner,
  signal (send,receive) peer=developer-os-runner-workload,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny mount,
  deny pivot_root,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/kernel/security/** rwklx,
}
